{"ratings":[{"id":"C1","consequence":"wrong","trigger":"plausible","reason":"A transient routing fetch failure leaves the retry picker disabled until it is reopened."},{"id":"C2","consequence":"wrong","trigger":"plausible","reason":"Clearing a model's default effort reports success while retaining the previous value."},{"id":"C3","consequence":"wrong","trigger":"normal","reason":"Reloading or revisiting Setup loses the requested catalog change history, and changes from other clients never appear."},{"id":"C4","consequence":"outage","trigger":"plausible","reason":"A cold install fails when the browser download is unavailable, which can block gates or deployment."},{"id":"C5","consequence":"wrong","trigger":"plausible","reason":"Frequent provider events can continually supersede preview requests, leaving routing previews unavailable until activity stops."},{"id":"C6","consequence":"diag","trigger":"plausible","reason":"A role-specific validation error is displayed and announced twice."}]}