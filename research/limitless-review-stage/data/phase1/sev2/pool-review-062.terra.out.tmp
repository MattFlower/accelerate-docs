{"ratings":[{"id":"C1","consequence":"wrong","trigger":"plausible","reason":"Cleanup can kill an unrelated orphaned job in a shared worktree, interrupting its work or causing another finder to fail."},{"id":"C2","consequence":"boundary","trigger":"plausible","reason":"A detached child outside the captured directories can survive invocation shutdown and continue modifying the checkout."},{"id":"C3","consequence":"boundary","trigger":"plausible","reason":"A detached child with a replacement environment can survive invocation shutdown and continue modifying the checkout."}]}