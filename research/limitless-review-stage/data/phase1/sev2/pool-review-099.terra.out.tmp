{"ratings":[{"id":"C1","consequence":"outage","trigger":"plausible","reason":"Restoring a model with settings incompatible with a saved routing override prevents the daemon from starting on its next restart."},{"id":"C2","consequence":"wrong","trigger":"plausible","reason":"Restoring a compatible model clears the warning while routing silently continues using the fallback until restart."},{"id":"C3","consequence":"wrong","trigger":"plausible","reason":"A bare IPv6 remote host makes every local-management action fail before SSH runs."},{"id":"C4","consequence":"wrong","trigger":"plausible","reason":"A tunneled or aliased provider is not matched, so management probes the wrong endpoint and fails to update provider enablement."},{"id":"C5","consequence":"resume","trigger":"plausible","reason":"An interrupted historical evaluation containing a retired model cannot resume, including its remaining work for available models."},{"id":"C7","consequence":"diag","trigger":"unusual","reason":"A persisted model ID in a provider preference is misleadingly reported as absent from the catalog."},{"id":"C9","consequence":"outage","trigger":"plausible","reason":"The reproduced validation gap allows a restored model to make the daemon fail on its next restart."},{"id":"C4b","consequence":"wrong","trigger":"plausible","reason":"A bare IPv6 remote host causes URL construction to fail before the management command contacts the server."},{"id":"C5b","consequence":"wrong","trigger":"plausible","reason":"Retrying a historical run fails validation when its saved model chain includes a retired model, even if an available fallback remains."}]}