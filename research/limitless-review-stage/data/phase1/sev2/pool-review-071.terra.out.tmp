{"ratings":[{"id":"C1","consequence":"wrong","trigger":"normal","reason":"A confirmed merge can be reported as needing review or having unknown PR state."},{"id":"C2","consequence":"wrong","trigger":"plausible","reason":"An external push can stale an acknowledged approval without causing the digest to report review work."},{"id":"C3","consequence":"wrong","trigger":"plausible","reason":"The digest requests review while requested changes are still queued or running."},{"id":"C4","consequence":"wrong","trigger":"plausible","reason":"A policy-file read failure silently removes the requested status and next action."},{"id":"C5","consequence":"wrong","trigger":"plausible","reason":"A historical landing block causes status to recommend retrying a closed or resolved PR."},{"id":"C6","consequence":"wrong","trigger":"plausible","reason":"An approval made before the first saved PR observation is incorrectly reported as needing review."},{"id":"C7","consequence":"outage","trigger":"unusual","reason":"An exceptionally long saved question can fill the agent's context at session start and prevent it from working."},{"id":"C10","consequence":"test","trigger":"normal","reason":"The formatting failure stops the required validation command before typechecking and tests."},{"id":"C11","consequence":"wrong","trigger":"plausible","reason":"A later approval hides an active changes round and prompts the agent to consider landing."},{"id":"C12","consequence":"wrong","trigger":"plausible","reason":"The documented Codex command reads Claude's feed cursor and can miss Codex's unread items."},{"id":"C13","consequence":"diag","trigger":"normal","reason":"The extra synchronous query has no demonstrated material runtime consequence or race."},{"id":"C14","consequence":"wrong","trigger":"normal","reason":"MCP review verdicts are recorded and reported with incorrect human attribution."}]}