{"ratings":[{"id":"C1","consequence":"wrong","trigger":"normal","reason":"Ordinary files in explicitly requested media formats are incorrectly blocked unless a binary allowance is granted."},{"id":"C2","consequence":"wrong","trigger":"normal","reason":"Valid PNGs with common text or color-profile metadata are incorrectly blocked as opaque binaries."},{"id":"C3","consequence":"wrong","trigger":"normal","reason":"Incidental byte patterns in valid media are mistaken for executable payloads and cause false audit blocks."},{"id":"C4","consequence":"wrong","trigger":"plausible","reason":"A valid high-resolution PNG can exceed the decoded-size cap and be incorrectly blocked despite its small file size."},{"id":"C4b","consequence":"wrong","trigger":"plausible","reason":"A valid media file larger than 32 MiB is incorrectly blocked because it exceeds the input-size cap."}]}