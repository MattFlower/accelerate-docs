   "reproduction": {
    "command": "copied test/lease-store.test.ts to $TMPDIR with absolute imports, appended the reviewer's 'restart drops a renewal whose unchanged record was never sent' test, and ran bun test <copy> -t 'renewal whose'",
    "output": "error: expect(received).toBe(expected)\nExpected: \"dropped\"\nReceived: \"applied\"\n(fail) review regression: restart drops a renewal whose unchanged record was never sent"
