{"ratings":[{"id":"C1","consequence":"wrong","trigger":"normal","reason":"Rerunning setup against a healthy daemon reports success while the daemon continues using stale configuration."},{"id":"C2","consequence":"bypass","trigger":"normal","reason":"The new setup verification checks static providers and endpoints instead of the effective configured providers."},{"id":"C3","consequence":"bypass","trigger":"plausible","reason":"A newly selected inaccessible repository is saved without the repository access check detecting the problem."},{"id":"C4","consequence":"wrong","trigger":"normal","reason":"Interactive setup omits the requested discreet-mode choice and does not save the preference."},{"id":"C5","consequence":"bypass","trigger":"plausible","reason":"Doctor accepts the presence of an OpenRouter key without checking whether the configured provider or credential works."},{"id":"C6","consequence":"diag","trigger":"plausible","reason":"A preset alias suppresses an explicit native provider entry and its summary, but the native provider and models remain available."},{"id":"C2b","consequence":"wrong","trigger":"plausible","reason":"Setup accepts a missing Codex CLI during preflight but subsequently schedules smoke checks that require it."}]}