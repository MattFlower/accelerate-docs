{"ratings":[{"id":"C1","consequence":"wrong","trigger":"normal","reason":"Ordinary requested media assets are incorrectly blocked unless the run grants a binary allowance."},{"id":"C2","consequence":"wrong","trigger":"normal","reason":"Adding or editing an executable text script incorrectly produces a blocking binary-content finding."},{"id":"C3","consequence":"wrong","trigger":"normal","reason":"Valid PNGs with common metadata are incorrectly blocked unless the run grants a binary allowance."},{"id":"C4","consequence":"bypass","trigger":"plausible","reason":"An ordinary text file containing a signature string can be hidden by a diff attribute without the separate attributes allowance when a binary allowance is present."},{"id":"C5","consequence":"wrong","trigger":"plausible","reason":"A small edit to a text file over the subprocess output limit is blocked by an inspection error that allowances cannot clear."}]}