   "reproduction": {
    "command": "bun -e 'import {extractFailures} from \"./src/gates/failures.ts\"; const r = extractFailures(\"not ok to retry\\n\".repeat(10) + \"error: actual assertion\\nExpected: 1\\nReceived: 2\\n(fail) actual test\"); console.log(r); console.log(\"has error:\", r?.includes(\"error: actual assertion\"))'",
    "output": "ten 'not ok to retry' excerpts, then '[failure excerpts: diagnostic lines or failures left out]'; has error: false"
   },
   "evidence": "failures.ts:17 `const failure = /^(?:\\(fail\\)(?:\\s|$)|not ok(?:\\s|$))/.test(text);` accepts any text after 'not ok ', with no test number required as in TAP's `not ok N`. Line 27 also treats any line starting with 'ok ' as a result boundary. The prompts.ts timeout parser already requires `(?:not )?ok[ \\t]+\\d+`."
