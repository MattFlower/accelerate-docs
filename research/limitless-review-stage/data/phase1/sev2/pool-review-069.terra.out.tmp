{"ratings":[{"id":"C1","consequence":"wrong","trigger":"normal","reason":"Starting a fix round leaves the PR incorrectly listed as awaiting review during an ordinary review workflow."},{"id":"C2","consequence":"wrong","trigger":"plausible","reason":"An external merge leaves a previously blocked land incorrectly listed as requiring attention."},{"id":"C3","consequence":"wrong","trigger":"plausible","reason":"When no PR snapshot or landed entry exists, status ignores the persisted merged flag and reports an unknown state."},{"id":"C4","consequence":"wrong","trigger":"plausible","reason":"A new commit invalidates an approval without restoring the PR to the digest's review list."},{"id":"C5","consequence":"wrong","trigger":"plausible","reason":"A valid approval after a failed fix round is hidden by the historical failure in status."},{"id":"C6","consequence":"wrong","trigger":"normal","reason":"Answering a question and resuming the run leaves the digest incorrectly reporting that input is needed."},{"id":"C7","consequence":"wrong","trigger":"plausible","reason":"An empty run filter now causes a land-list request to fail instead of returning the list."},{"id":"C8","consequence":"wrong","trigger":"normal","reason":"MCP approvals are persisted and reported as human approvals, misattributing their source."},{"id":"C9","consequence":"wrong","trigger":"plausible","reason":"A closed PR with an earlier blocked land receives status advice to retry landing even though the queue rejects it."},{"id":"C10","consequence":"wrong","trigger":"plausible","reason":"Resolving or cancelling a run with an open PR leaves that PR incorrectly listed as awaiting review."},{"id":"C11","consequence":"wrong","trigger":"normal","reason":"The bundled Codex instruction reads Claude's consumer cursor, so Claude's acknowledgements can hide items from the Codex digest."}]}