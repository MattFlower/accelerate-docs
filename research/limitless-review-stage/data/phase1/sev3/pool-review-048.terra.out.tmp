{"ratings":[{"id":"C1","consequence":"wrong","trigger":"normal","reason":"Ordinary files in several explicitly exempted media formats are blocked, refusing runs unless a binary allowance is supplied."},{"id":"C2","consequence":"wrong","trigger":"normal","reason":"Common PNG metadata causes valid images to be blocked and runs to be refused without a binary allowance."},{"id":"C3","consequence":"wrong","trigger":"normal","reason":"Incidental executable-signature bytes in ordinary media data cause valid files to be blocked and runs to be refused."},{"id":"C4","consequence":"wrong","trigger":"plausible","reason":"A valid high-resolution image can exceed the decoded size limit and cause a run to be refused without a binary allowance."},{"id":"C4b","consequence":"wrong","trigger":"plausible","reason":"A valid audio file over 32 MiB is excluded from the media exemption and can cause a run to be refused."}]}