{"ratings":[{"id":"F1","consequence":"secret","trigger":"plausible","reason":"A gate name or command containing a registered credential can be copied unredacted into a stored verification artifact."},{"id":"F2","consequence":"state","trigger":"plausible","reason":"Resuming a repository with scripts named \"ok\" and \"output\" corrupts the persisted script baseline and can cause a false blocking audit."},{"id":"F3","consequence":"secret","trigger":"plausible","reason":"A restored shadow-review error containing a credential is copied unredacted into a stored artifact."},{"id":"F4","consequence":"boundary","trigger":"plausible","reason":"Printing restored evidence with terminal control sequences lets that evidence control the owner's terminal."},{"id":"F5","consequence":"diag","trigger":"plausible","reason":"A citation containing redacted text can be incorrectly reported as absent, but the reproduced validation issue does not change the verification verdict."}]}