   "reproduction": {
    "command": "bun -e 'import {mkdtempSync,writeFileSync,rmSync} from \"node:fs\"; import {tmpdir} from \"node:os\"; import {join} from \"node:path\"; import {loadConfig} from \"./src/config.ts\"; import {resolveClientPort} from \"./src/cli/client-port.ts\"; import {apiTokenHeaders} from \"./src/cli/api-token.ts\"; const d=mkdtempSync(join(tmpdir(),\"adjudicate-port-\")); try {process.env.LIMITLESS_HOME=d;process.env.LIMITLESS_CONFIG_DIR=d;writeFileSync(join(d,\"api-token\"),\"synthetic-token\");writeFileSync(join(d,\"config.toml\"),\"[server]\\nport = 49752\\n\");process.env.LIMITLESS_PORT=\"+49751\";for(const binding of [\"missing\",\"stale\"]){if(binding===\"stale\")writeFileSync(join(d,\"api-token.origin\"),JSON.stringify({origin:\"http://127.0.0.1:49751\",tokenHash:\"stale\"}));console.log(JSON.stringify({binding,daemon:loadConfig({readOnly:true}).port,client:resolveClientPort(),wrongListenerGetsBearer:!!apiTokenHeaders(\"http://127.0.0.1:49752\").authorization,daemonGetsBearer:!!apiTokenHeaders(\"http://127.0.0.1:49751\").authorization}));}rmSync(join(d,\"api-token.origin\"));delete process.env.LIMITLESS_PORT;writeFileSync(join(d,\"config.toml\"),\"[server]\\nport = 0\\n\");console.log(JSON.stringify({configured:0,daemon:loadConfig({readOnly:true}).port,client:resolveClientPort(),bearerAt7400:!!apiTokenHeaders(\"http://127.0.0.1:7400\").authorization}));}finally{rmSync(d,{recursive:true,force:true});}'",
