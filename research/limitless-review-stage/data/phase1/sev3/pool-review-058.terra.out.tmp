{"ratings":[{"id":"C1","consequence":"nuisance","trigger":"plausible","reason":"A temporary routing fetch failure disables the picker until the operator closes and reopens it."},{"id":"C2","consequence":"wrong","trigger":"plausible","reason":"Clearing the default effort silently preserves the old value, so later routing can use an unintended setting."},{"id":"C3","consequence":"wrong","trigger":"normal","reason":"Reloading or revisiting Setup loses the visible catalog history, preventing the operator from reviewing recent changes."},{"id":"C4","consequence":"outage","trigger":"plausible","reason":"A cold install fails when the required browser download cannot reach its CDN, potentially blocking gates or deploys."},{"id":"C5","consequence":"wrong","trigger":"normal","reason":"Provider activity can continually supersede preview requests, leaving routing previews unavailable while events continue."},{"id":"C6","consequence":"diag","trigger":"plausible","reason":"A role-specific validation error appears and is announced twice without changing the retry result."}]}