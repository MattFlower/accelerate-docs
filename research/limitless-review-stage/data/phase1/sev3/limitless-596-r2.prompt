    "command": "bun $TMPDIR/adj/r.ts  (sanitizePublication(('x'.repeat(279)+' '+W+'/a.ts').slice(0,300), W, D) with D=/Users/example/.factory, W=D/work/run)",
    "output": "F1: \"xxxxxxxxx /Users/example/.fact\""
