   "reproduction": {
    "command": "bun $TMPDIR/f1/repro.ts $PWD  # loadConfig with queue.repos=[\"Owner/Repo\",\"owner/repo\"], store holds slug Owner/Repo, build issueRunRequest from the queue repo, then getRepoBySlug(req.repo)",
