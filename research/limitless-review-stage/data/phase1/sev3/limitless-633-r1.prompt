  "B": {
   "verdict": "REAL",
   "failure_scenario": "A worker starts updating: it checks out the new commit, and then `bun install` fails partway, for example on a network error. The worker switches its code back to the old commit but keeps the half-installed new dependencies, so a later restart on the old release can run against packages that don't match its lockfile.",
   "reproduction": {
