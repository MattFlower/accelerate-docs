{"ratings":[{"id":"C1","consequence":"wrong","trigger":"plausible","reason":"Cleanup can kill an unrelated orphaned job in the same checkout, interrupting and potentially losing its work."},{"id":"C2","consequence":"wrong","trigger":"plausible","reason":"A detached child outside the captured directories can keep writing into the checkout after shutdown, interfering with subsequent work."},{"id":"C3","consequence":"wrong","trigger":"plausible","reason":"A detached child with a replaced environment can survive shutdown and keep writing in the checkout, interfering with subsequent work."}]}