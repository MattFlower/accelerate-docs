{"ratings":[{"id":"F1","consequence":"secret","trigger":"plausible","reason":"A credential embedded in a gate command is sent to the worker, although the evidence indicates the worker also receives it through the repository bundle."},{"id":"F2","consequence":"wrong","trigger":"plausible","reason":"Persistent bundle download failures can leave a gate leased indefinitely, stalling the run despite healthy heartbeats."},{"id":"F3","consequence":"outage","trigger":"plausible","reason":"A gate that leaves an unreadable directory can terminate the worker loop and prevent it from processing subsequent jobs."},{"id":"F4","consequence":"nuisance","trigger":"unusual","reason":"A worker holding an unusually large number of jobs causes repeated database scans and event-loop overhead without a demonstrated incorrect result."},{"id":"F5","consequence":"nuisance","trigger":"normal","reason":"Each completed job leaves temporary refs that pin old history and gradually increase cache storage."},{"id":"F6","consequence":"wrong","trigger":"unusual","reason":"A worker returning checks out of order can cause retry processing to attribute outcomes to the wrong checks."}]}