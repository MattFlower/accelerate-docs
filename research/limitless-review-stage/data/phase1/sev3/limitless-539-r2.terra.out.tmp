{"ratings":[{"id":"F1","consequence":"boundary","trigger":"plausible","reason":"A modified submodule mapping lets a nested repository execute an agent-controlled filter outside confinement during merge preparation."},{"id":"F2","consequence":"wrong","trigger":"plausible","reason":"Valid file-to-directory or directory-to-symlink replacements cause staging to fail and block the run."},{"id":"F3","consequence":"wrong","trigger":"plausible","reason":"A conflict in .gitmodules prevents cleanup from aborting the merge or rebase, leaving the checkout stuck."}]}