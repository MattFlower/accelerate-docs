{"ratings":[{"id":"C1","consequence":"resume","trigger":"unusual","reason":"A local run in flight during an upgrade from an older release cannot be recovered because its source-owned worktree is rejected."},{"id":"C2","consequence":"resume","trigger":"unusual","reason":"An upgrade interrupting preparation before baseline gate evidence is emitted leaves the existing worktree unrecognized and the resumed run fails."},{"id":"C3","consequence":"resume","trigger":"plausible","reason":"Runs prepared on an older release after the fixed cutoff are excluded from migration and fail on resume."},{"id":"C4","consequence":"wrong","trigger":"plausible","reason":"A resumed run with a worktree trust problem is reported as failed instead of retaining its human-review status and reason."},{"id":"C3b","consequence":"resume","trigger":"unusual","reason":"A later failed prepare attempt can exclude an older unrecorded worktree from recovery, causing the run to fail on resume."}]}