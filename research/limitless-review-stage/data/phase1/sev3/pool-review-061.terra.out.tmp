{"ratings":[{"id":"C1","consequence":"boundary","trigger":"normal","reason":"Routine command cleanup can misidentify unrelated same-user processes as invocation members and terminate them outside the invocation's process boundary."},{"id":"C2","consequence":"wrong","trigger":"plausible","reason":"A transient cleanup failure before a timed-out gate rerun aborts the run instead of retrying cleanup or recovering in another round."},{"id":"C3","consequence":"wrong","trigger":"plausible","reason":"A background writer with a replacement environment can survive invocation cleanup and alter the worktree while the factory proceeds."}]}