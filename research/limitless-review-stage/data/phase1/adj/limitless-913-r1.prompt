nd: ctx.state.round,\n      deadline: Date.now() + 60_000,\n      result: {\n        setupOk: true,\n        timedOut: false,\n        comparison: [\n          {\n            name: \"check\",\n            verdict: \"flaky\",\n            blocking: false,\n            postMergeWorker: \"test-worker\",\n            firstAttempt: original,\n            result: { ...passed, firstAttempt: original },\n            ...(kind === \"confirmation\"\n              ? {\n                  coordinatorConfirmation: {\n                    worker: \"test-worker\",\n                    originalVerdict: \"regressed\" as const,\n                    reason: \"pass (worker-specific flake)\",\n                    result: { ...passed, firstAttempt: original },\n                  },\n                }\n              : {}),\n          },\n        ],\n      },\n    };\n    await ctx.save();\n    const resumed = restore();\n    const comparisons = resumed.state.postMergeGates?.result?.comparison;\n    if (!comparisons) throw new Error(\"Missing restored comparison\");\n    const { confirmPostMerge } = await import(\"../src/pipeline/post-merge-confirmation.ts\");\n    await confirmPostMerge(resumed, cwd, gates, comparisons, Date.now() + 60_000, sha, async () => {});\n    expect(comparisons[0]).toMatchObject({ blocking: true, verdict: \"regressed\", result: { ok: false } });\n  },\n);\n\n```"
